{
    "version": 2,
    "buildCommand": "npm run build && node prisma/push-turso.mjs",
    "outputDirectory": "web/dist",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index"
        }
    ],
    "functions": {
        "api/index.mjs": {
            "includeFiles": "web/**"
        }
    }
}